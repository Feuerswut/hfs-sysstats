{
  "_comment": "Default config for hfs-sysstats. DO NOT edit this file. Edit storage/config.json instead. Deleted storage/config.json is regenerated from this file + hardware detection.",

  "display": {
    "cpu":              true,
    "cpuCores":         true,
    "cpuCurrentSpeed":  true,
    "cpuTemperature":   true,
    "memory":           true,
    "memoryLayout":     false,
    "disk":             true,
    "diskIO":           true,
    "diskLayout":       false,
    "network":          true,
    "networkLatency":   true,
    "processes":        true,
    "processesTop":     10,
    "system":           true,
    "graphics":         false,
    "battery":          false,
    "docker":           false
  },

  "network": {
    "interfaces":   ["*"],
    "showInternal": false,
    "showVirtual":  false
  },

  "disk": {
    "mounts": ["*"]
  },

  "docker": {
    "showContainers": true,
    "showImages":     false
  },

  "charts": {
    "maxDataPoints":   20,
    "refreshInterval": 3000
  }
}
