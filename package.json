{
  "name": "hfs-sysstats",
  "version": "1.0.0",
  "private": true,
  "description": "System Statistics Dashboard, as an HFS plugin",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "build:watch": "node build/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist/public',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "sass": "^1.81.0",
    "typescript": "^5.6.3"
  }
}
